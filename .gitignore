# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Supabase: ignore local CLI state, DB files, caches and secrets
supabase/.supabase/
supabase/.local/
supabase/.db
supabase/.psql_history
supabase/.cache/
supabase/.tmp
supabase/.secrets
supabase/.env
supabase/.env.local
supabase/.temp/
supabase/.branches/

# Supabase functions build artifacts
supabase/functions/**/node_modules/
supabase/functions/**/dist/

# Optional: local storage or uploads
supabase/storage/